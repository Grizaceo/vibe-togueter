# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# Vibe Arena controller on this host (same values as the controller .env)
# VA_ARENA_URL=http://127.0.0.1:8420
# Controller local-admin bearer; only needed when the controller sets one.
# VA_ADMIN_TOKEN=
# Controller streamer confirmation key; the console unlock checks it and sends
# it as x-streamer-key. Never shown to the browser or the agent.
# VA_STREAMER_KEY=
